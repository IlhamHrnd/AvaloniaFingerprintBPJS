<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harness konsol berdiri sendiri untuk memvalidasi FaceRecognitionService.
    Sengaja BUKAN bagian dari build app utama: AvaloniaFingerprint.csproj punya
    <Compile Remove="tools\**" /> supaya file di folder ini tidak ikut tersapu.

    Dijalankan manual, bukan dari CI, karena butuh ~126 MB model dlib dan native x64.
    Dari root repo (perintah berbentuk panjang ada di README.md):

      dotnet build tools\FaceEncodingProbe\FaceEncodingProbe.csproj -c Debug
      tools\FaceEncodingProbe\bin\Debug\net8.0-windows\FaceEncodingProbe.exe

    Exit code 0 = semua kasus lulus, 1 = ada yang gagal, 2 = prasyarat belum diunduh.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FaceEncodingProbe</RootNamespace>
    <AssemblyName>FaceEncodingProbe</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Harness ini tidak boleh memicu build warning app utama jadi error. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);WFAC010;AVLN5001;NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ProjectReference (bukan menyalin source) supaya yang diuji benar-benar
      FaceRecognitionService yang sama dengan yang dipakai app, termasuk jalur
      BaseService / AppSettings-nya.
    -->
    <ProjectReference Include="..\..\AvaloniaFingerprint.csproj" />
  </ItemGroup>

</Project>
