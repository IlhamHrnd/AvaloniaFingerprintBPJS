<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaFingerprint.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
             x:Class="AvaloniaFingerprint.Views.VerifikasiView"
             x:DataType="vm:VerifikasiViewModel">

  <Grid ColumnDefinitions="360,*" Margin="16">

    <!-- ============ kiri: identitas peserta + panel metode aktif ============ -->
    <Border Grid.Column="0" Classes="card" VerticalAlignment="Top" Margin="0,0,16,0">
      <!-- ScrollViewer wajib ada di sini: tinggi card dibatasi window sedangkan isinya bisa jauh
           lebih tinggi, terutama karena StatusMessage dan CameraDeviceList memakai TextWrapping
           sehingga tingginya tidak terbatas. Tanpa ini, tombol verifikasi dan pesan error NIK
           terdorong keluar card dan tidak terlihat. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Verifikasi" />

        <!-- NIK peserta: field bersama untuk KEDUA metode. Diisi sekali, lalu dipakai metode
             Fingerprint (saat metode nomor "NIK" yang dipilih) maupun metode Wajah. Karena itu
             field ini berada di ATAS pemilih metode, bukan di dalam salah satu panel.
             PlaceholderText dipakai karena Watermark sudah obsolete (memicu AVLN5001). -->
        <StackPanel Spacing="4">
          <TextBlock Text="NIK" FontWeight="SemiBold" FontSize="12" />
          <TextBox Text="{Binding Nik}"
                   MaxLength="16"
                   PlaceholderText="Masukkan NIK"
                   Height="36" FontSize="15" />
        </StackPanel>

        <!-- Pemilih metode. Hanya panel milik metode yang dipilih yang ditampilkan; panel metode
             lain disembunyikan, bukan dibongkar, supaya isi inputnya tidak hilang saat operator
             berpindah bolak-balik. -->
        <StackPanel Spacing="4">
          <TextBlock Text="Metode Verifikasi" FontWeight="SemiBold" FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton GroupName="metode" Content="Fingerprint" IsChecked="{Binding IsFingerprintMode}" />
            <RadioButton GroupName="metode" Content="Wajah" IsChecked="{Binding IsWajahMode}" />
          </StackPanel>
        </StackPanel>

        <!-- ================= panel metode: FINGERPRINT ================= -->
        <StackPanel IsVisible="{Binding IsFingerprintMode}" Spacing="14">

          <!-- Metode nomor menentukan field mana yang dikirim sebagai keyword verifikasi. Saat
               "NIK" dipilih, field Nomor disembunyikan karena NIK bersama di atas yang dipakai;
               saat "No. BPJS" dipilih, field Nomor tampil dengan batas 13 digit. -->
          <StackPanel Spacing="6">
            <TextBlock Text="Jenis Nomor" FontWeight="SemiBold" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <RadioButton GroupName="jenis" Content="NIK" IsChecked="{Binding IsNik}" />
              <RadioButton GroupName="jenis" Content="No. BPJS" IsChecked="{Binding IsNoBpjs}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding IsNoBpjs}">
            <TextBlock Text="Nomor" FontWeight="SemiBold" FontSize="12" />
            <TextBox Text="{Binding Number}"
                     MaxLength="{Binding NumberMaxLength}"
                     PlaceholderText="Minimal 13 digit"
                     Height="38" FontSize="15" />
            <TextBlock Classes="caption" Text="No. BPJS 13 digit" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Verifikasi" Command="{Binding VerifyCommand}"
                    Height="38" MinWidth="120" HorizontalContentAlignment="Center"
                    Background="{StaticResource AccentBrush}" Foreground="White" />
            <Button Content="Bersihkan" Command="{Binding ClearCommand}"
                    Height="38" MinWidth="100" HorizontalContentAlignment="Center" />
          </StackPanel>

          <!-- Progres pemindaian. ScanStatus diisi bertahap dari "Letakkan jari..." sampai
               "Memproses cetak Label...", jadi operator selalu tahu tahap yang sedang berjalan. -->
          <StackPanel IsVisible="{Binding IsScanning}" Spacing="6">
            <TextBlock Text="{Binding ScanStatus}" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource AccentBrush}" />
            <ProgressBar IsIndeterminate="True" Height="4" />
          </StackPanel>

          <Border IsVisible="{Binding !DeviceConnected}" CornerRadius="6" Padding="10" Background="#FEF3C7">
            <TextBlock Text="Perangkat fingerprint tidak terhubung. Verifikasi dinonaktifkan."
                       TextWrapping="Wrap" FontSize="12" Foreground="#92400E" />
          </Border>
        </StackPanel>

        <!-- =================== panel metode: WAJAH =================== -->
        <StackPanel IsVisible="{Binding IsWajahMode}" Spacing="10">
          <!-- Area gambar. Isinya mengikuti sumber yang dipilih: frame live kamera atau foto yang
               diupload. Bingkai frame digambar oleh CameraServices (OpenCV) dan dikirim sebagai frame
               BGRA; bitmap ditukar setiap frame oleh VerifikasiViewModel. Placeholder hanya
               tampil selama belum ada frame maupun foto. -->
          <Border CornerRadius="6" Height="240"
                  Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1"
                  HorizontalAlignment="Stretch">
            <Panel>
              <!-- PreviewImage mengikuti sumber yang dipilih: frame live, atau foto upload. -->
              <Image Source="{Binding PreviewImage}"
                     Stretch="Uniform"
                     IsVisible="{Binding IsPreviewVisible}" />

              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                          IsVisible="{Binding !IsPreviewVisible}">
                <TextBlock Text="📷" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CameraTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CameraStatus}" Classes="caption" HorizontalAlignment="Center" />
              </StackPanel>
            </Panel>
          </Border>

          <!-- Tombol utama: cari & pilih kamera aktif (keyword berprioritas, lalu fallback),
               memakai mekanisme deteksi yang sama dengan status kamera di Header. -->
          <Button Content="Hubungkan Kamera" Command="{Binding ConnectCameraCommand}"
                  Height="38" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  IsEnabled="{Binding !IsConnecting}"
                  Background="{StaticResource AccentBrush}" Foreground="White" />

          <!-- Sumber gambar manual: memakai foto dari file sebagai pengganti live camera. -->
          <Button Content="Upload Foto" Command="{Binding UploadPhotoCommand}"
                  Height="38" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="{StaticResource AccentBrush}" Foreground="White" />

          <!-- Penukar sumber gambar (live camera <-> foto upload). Hanya tampil bila sudah ada foto
               yang diupload, sehingga pengguna tidak pernah terjebak di salah satu sumber. -->
          <Button Content="{Binding PhotoSourceActionLabel}" Command="{Binding TogglePhotoSourceCommand}"
                  IsVisible="{Binding HasUploadedPhoto}"
                  Height="38" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />

          <Button Content="Verifikasi Wajah" Command="{Binding VerifyFaceCommand}"
                  Height="38" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="{StaticResource AccentBrush}" Foreground="White" />

          <!-- Daftar kamera yang dikenali Windows pada scan terakhir (memudahkan pengecekan device,
               termasuk kamera HP lewat Link to Windows / Phone Link dan kamera virtual lain). -->
          <Border IsVisible="{Binding HasCameraDeviceList}" CornerRadius="6" Padding="10" Background="#F9FAFB"
                  BorderBrush="#E5E7EB" BorderThickness="1">
            <TextBlock Text="{Binding CameraDeviceList}" TextWrapping="Wrap" FontSize="12"
                       Foreground="#374151" />
          </Border>
        </StackPanel>

        <!-- Status bersama: satu Border untuk kedua metode. Isinya diisi SetStatus(),
             dan warna teksnya mengikuti StatusIsError lewat converter StatusBrush. -->
        <Border IsVisible="{Binding HasStatus}" CornerRadius="6" Padding="10" Background="#F3F4F6">
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{Binding !StatusIsError, Converter={StaticResource StatusBrush}}" />
        </Border>
      </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ====== kanan: hasil verifikasi (satu kartu untuk kedua metode) ====== -->
    <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
      <StackPanel Spacing="14">
        <TextBlock Classes="h2" Text="Hasil Verifikasi" />

        <Grid ColumnDefinitions="Auto,*">

          <!-- Gambar peserta. Sumbernya mengikuti metode yang aktif: base64 sidik jari untuk
               metode Fingerprint, atau foto yang diverifikasi untuk metode Wajah. Kotaknya satu
               dan berukuran tetap supaya kartu hasil tidak berubah bentuk saat metode berpindah. -->
          <Border Grid.Column="0" Width="140" Height="180" CornerRadius="6" Margin="0,0,20,0"
                  Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1"
                  VerticalAlignment="Top">
            <Panel>
              <!-- metode Fingerprint: sidik jari hasil capture (base64 -> gambar lewat converter) -->
              <Panel IsVisible="{Binding IsFingerprintMode}">
                <TextBlock Text="Sidik jari" Classes="caption"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding FingerImage, Converter={x:Static ObjectConverters.IsNull}}" />
                <Image Source="{Binding FingerImage, Converter={StaticResource Base64Image}}"
                       Stretch="Uniform" Margin="6" />
              </Panel>

              <!-- metode Wajah: foto yang diverifikasi. Dibiarkan memakai rasio aslinya di dalam
                   kotak berukuran tetap, supaya wajah tidak terlihat gepeng. -->
              <Panel IsVisible="{Binding IsWajahMode}">
                <Image Source="{Binding CapturedPhoto}"
                       Stretch="Uniform"
                       IsVisible="{Binding HasCapturedPhoto}" />

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                            IsVisible="{Binding !HasCapturedPhoto}">
                  <TextBlock Text="🙂" FontSize="28" HorizontalAlignment="Center" />
                  <TextBlock Text="Wajah" Classes="caption" HorizontalAlignment="Center" />
                </StackPanel>
              </Panel>
            </Panel>
          </Border>

          <!-- detail hasil -->
          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="130,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama" Classes="caption" Margin="0,0,0,12" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ResultNama}"
                       FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="No. Kartu" Classes="caption" Margin="0,0,0,12" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResultNoKartu}"
                       FontSize="15" Margin="0,0,0,12" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Usia" Classes="caption" Margin="0,0,0,12" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ResultUsia}"
                       FontSize="15" Margin="0,0,0,12" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Keterangan" Classes="caption" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ResultKeterangan}"
                       TextWrapping="Wrap" FontSize="12" />
          </Grid>
        </Grid>

        <!-- Membuang foto upload dan hasil verifikasi wajah, lalu kembali ke live camera. Hanya
             relevan untuk metode Wajah, jadi seluruhnya disembunyikan saat metode Fingerprint
             yang aktif. -->
        <StackPanel IsVisible="{Binding IsWajahMode}">
          <Button Content="Hapus Foto" Command="{Binding ClearPhotoCommand}"
                  IsVisible="{Binding HasAnyPhoto}"
                  HorizontalAlignment="Left" Height="34" Padding="16,0"
                  HorizontalContentAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
