<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaFingerprint.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
             x:Class="AvaloniaFingerprint.Views.VerifikasiView"
             x:DataType="vm:VerifikasiViewModel">

  <Panel>

    <!-- ===== Konten utama: dua kolom (§8.5), kedua kartu stretch setinggi kolom ===== -->
    <Grid ColumnDefinitions="360,*" Margin="16">

      <!-- ===== Kolom kiri: Identitas & Verifikasi ===== -->
      <Border Grid.Column="0" Classes="card" VerticalAlignment="Stretch" Margin="0,0,16,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="{StaticResource App.Space.M}">

            <TextBlock Classes="h2" Text="Identitas &amp; Verifikasi" />

            <!-- NIK / No. BPJS (§9.2) -->
            <StackPanel Spacing="{StaticResource App.Space.XS}">
              <TextBlock Classes="field-label" Text="NIK / No. BPJS" />
              <TextBox Text="{Binding IdentityNumber}"
                       MaxLength="16" Height="36"
                       PlaceholderText="Masukkan NIK (16 digit)"
                       IsEnabled="{Binding !IsResultProcessing}" />
              <TextBlock Classes="caption" Text="NIK 16 digit / No. BPJS 13 digit" />
            </StackPanel>

            <!-- ===== Numpad sentuh (input angka tanpa keyboard fisik) =====
                 Tombol menulis ke IdentityNumber; sanitasi & batas 16 digit tetap
                 ditangani OnIdentityNumberChanged, jadi validasi tidak berubah. -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="{StaticResource App.Space.S}"
                  RowSpacing="{StaticResource App.Space.S}"
                  IsEnabled="{Binding !IsResultProcessing}">
              <Button Grid.Row="0" Grid.Column="0" Classes="numpad" Content="1"
                      Command="{Binding AppendDigitCommand}" CommandParameter="1"
                      AutomationProperties.Name="Angka 1" />
              <Button Grid.Row="0" Grid.Column="1" Classes="numpad" Content="2"
                      Command="{Binding AppendDigitCommand}" CommandParameter="2"
                      AutomationProperties.Name="Angka 2" />
              <Button Grid.Row="0" Grid.Column="2" Classes="numpad" Content="3"
                      Command="{Binding AppendDigitCommand}" CommandParameter="3"
                      AutomationProperties.Name="Angka 3" />

              <Button Grid.Row="1" Grid.Column="0" Classes="numpad" Content="4"
                      Command="{Binding AppendDigitCommand}" CommandParameter="4"
                      AutomationProperties.Name="Angka 4" />
              <Button Grid.Row="1" Grid.Column="1" Classes="numpad" Content="5"
                      Command="{Binding AppendDigitCommand}" CommandParameter="5"
                      AutomationProperties.Name="Angka 5" />
              <Button Grid.Row="1" Grid.Column="2" Classes="numpad" Content="6"
                      Command="{Binding AppendDigitCommand}" CommandParameter="6"
                      AutomationProperties.Name="Angka 6" />

              <Button Grid.Row="2" Grid.Column="0" Classes="numpad" Content="7"
                      Command="{Binding AppendDigitCommand}" CommandParameter="7"
                      AutomationProperties.Name="Angka 7" />
              <Button Grid.Row="2" Grid.Column="1" Classes="numpad" Content="8"
                      Command="{Binding AppendDigitCommand}" CommandParameter="8"
                      AutomationProperties.Name="Angka 8" />
              <Button Grid.Row="2" Grid.Column="2" Classes="numpad" Content="9"
                      Command="{Binding AppendDigitCommand}" CommandParameter="9"
                      AutomationProperties.Name="Angka 9" />

              <Button Grid.Row="3" Grid.Column="0" Classes="numpad" Content="0"
                      Command="{Binding AppendDigitCommand}" CommandParameter="0"
                      AutomationProperties.Name="Angka 0" />
              <Button Grid.Row="3" Grid.Column="1" Classes="numpad action"
                      Command="{Binding BackspaceCommand}"
                      AutomationProperties.Name="Hapus satu karakter">
                <TextBlock Classes="glyph" Text="&#xE750;"
                           Foreground="{DynamicResource App.Text.Secondary.Brush}" />
              </Button>
              <Button Grid.Row="3" Grid.Column="2" Classes="numpad action"
                      Command="{Binding ClearCommand}"
                      AutomationProperties.Name="Kosongkan input">
                <TextBlock Classes="glyph" Text="&#xE74D;"
                           Foreground="{DynamicResource App.Text.Secondary.Brush}" />
              </Button>
            </Grid>

            <!-- Metode verifikasi -->
            <StackPanel Spacing="{StaticResource App.Space.XS}">
              <TextBlock Classes="field-label" Text="Metode Verifikasi" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.L}">
                <RadioButton GroupName="metode" Content="Sidik Jari"
                             IsChecked="{Binding IsFingerprintMode}"
                             IsEnabled="{Binding !IsResultProcessing}" />
                <RadioButton GroupName="metode" Content="Wajah"
                             IsChecked="{Binding IsWajahMode}"
                             IsEnabled="{Binding !IsResultProcessing}" />
              </StackPanel>
            </StackPanel>

            <!-- ===== Aksi sidik jari ===== -->
            <StackPanel IsVisible="{Binding IsFingerprintMode}" Spacing="{StaticResource App.Space.M}">

              <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                <Button Classes="primary large" Command="{Binding VerifyCommand}"
                        AutomationProperties.Name="Ambil dan Verifikasi sidik jari">
                  <Panel MinWidth="120">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}"
                                HorizontalAlignment="Center" IsVisible="{Binding !IsBusy}">
                      <TextBlock Classes="glyph" Text="&#xE928;"
                                 Foreground="{DynamicResource App.Text.OnAccent.Brush}" />
                      <TextBlock Text="Ambil &amp; Verifikasi" />
                    </StackPanel>
                    <ProgressBar Classes="busy" IsVisible="{Binding IsBusy}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource App.Text.OnAccent.Brush}"
                                 Background="Transparent" />
                  </Panel>
                </Button>
                <Button Classes="secondary" Content="Verifikasi Ulang" MinWidth="80"
                        Command="{Binding VerifyCommand}"
                        IsVisible="{Binding HasResult}" />
                <Button Classes="secondary" Content="Reset" MinWidth="80"
                        Command="{Binding ClearCommand}" />
              </StackPanel>

              <!-- Progress pemindaian (§9.9) -->
              <StackPanel IsVisible="{Binding IsScanning}" Spacing="{StaticResource App.Space.XS}">
                <ProgressBar Classes="busy" Width="NaN" HorizontalAlignment="Stretch" />
                <TextBlock Classes="caption" Text="{Binding ScanStatus}" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Perangkat tidak terhubung (§10.2) -->
              <Border Classes="banner warning" IsVisible="{Binding !DeviceConnected}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                  <TextBlock Classes="glyph" Text="&#xE7BA;" VerticalAlignment="Center" />
                  <TextBlock Text="Perangkat sidik jari tidak terhubung. Verifikasi dinonaktifkan sampai perangkat siap."
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ===== Aksi verifikasi wajah (§8.5) ===== -->
            <StackPanel IsVisible="{Binding IsWajahMode}" Spacing="{StaticResource App.Space.M}">

              <!-- Preview kamera / foto -->
              <Border Height="240" ClipToBounds="True"
                      CornerRadius="{StaticResource App.Radius.M}"
                      Background="{DynamicResource App.Surface.PhotoPlaceholder.Brush}"
                      BorderBrush="{DynamicResource App.Border.Default.Brush}"
                      BorderThickness="1">
                <Panel>
                  <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding IsPreviewVisible}" />
                  <StackPanel IsVisible="{Binding !IsPreviewVisible}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Spacing="{StaticResource App.Space.XS}">
                    <TextBlock Classes="glyph" Text="&#xE722;" FontSize="24"
                               Foreground="{DynamicResource App.Text.Muted.Brush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CameraTitle}"
                               FontSize="{StaticResource App.Type.Body}" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text.Secondary.Brush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="caption" Text="{Binding CameraStatus}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="16,0,16,0" />
                  </StackPanel>
                </Panel>
              </Border>

              <Border Classes="banner info" IsVisible="{Binding HasCameraDeviceList}">
                <TextBlock Text="{Binding CameraDeviceList}" TextWrapping="Wrap" />
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                <Button Classes="secondary" Command="{Binding ConnectCameraCommand}"
                        MinWidth="80" AutomationProperties.Name="Hubungkan Kamera">
                  <Panel MinWidth="120">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}"
                                HorizontalAlignment="Center" IsVisible="{Binding !IsConnecting}">
                      <TextBlock Classes="glyph" Text="&#xE722;" />
                      <TextBlock Text="Hubungkan Kamera" />
                    </StackPanel>
                    <ProgressBar Classes="busy" IsVisible="{Binding IsConnecting}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Button>
                <Button Classes="secondary" Content="Upload Foto" MinWidth="80"
                        Command="{Binding UploadPhotoCommand}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                <Button Classes="ghost" Content="{Binding PhotoSourceActionLabel}"
                        Command="{Binding TogglePhotoSourceCommand}"
                        IsVisible="{Binding HasUploadedPhoto}" />
                <Button Classes="ghost" Content="Hapus Foto"
                        Command="{Binding ClearPhotoCommand}"
                        IsVisible="{Binding HasAnyPhoto}" />
                <Button Classes="ghost" Content="Reset" Command="{Binding ClearCommand}" />
              </StackPanel>

              <Button Classes="primary large" Command="{Binding VerifyFaceCommand}"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Verifikasi Wajah">
                <Panel>
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}"
                              HorizontalAlignment="Center" IsVisible="{Binding !IsVerifyingFace}">
                    <TextBlock Classes="glyph" Text="&#xE722;"
                               Foreground="{DynamicResource App.Text.OnAccent.Brush}" />
                    <TextBlock Text="Verifikasi Wajah" />
                  </StackPanel>
                  <ProgressBar Classes="busy" IsVisible="{Binding IsVerifyingFace}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.Text.OnAccent.Brush}"
                               Background="Transparent" />
                </Panel>
              </Button>

              <TextBlock Classes="caption" Text="{Binding FaceStatus}" TextWrapping="Wrap"
                         IsVisible="{Binding IsVerifyingFace}" />
              <TextBlock Classes="caption" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                         IsVisible="{Binding IsIdleFaceHint}" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- ===== Kolom kanan: Hasil Verifikasi — lima state (§10.1) ===== -->
      <Border Grid.Column="1" Classes="result-panel" VerticalAlignment="Stretch"
              MaxWidth="560" HorizontalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*">

          <TextBlock Grid.Row="0" Classes="h2" Text="Hasil Verifikasi" />

          <Grid Grid.Row="1">

            <!-- State 1 — Empty: belum ada proses/hasil -->
            <StackPanel IsVisible="{Binding IsResultEmpty}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="{StaticResource App.Space.M}">
              <Border Classes="photo-slot">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="{StaticResource App.Space.XS}">
                  <TextBlock Classes="glyph" Text="&#xE722;" FontSize="20"
                             Foreground="{DynamicResource App.Text.Muted.Brush}"
                             HorizontalAlignment="Center" />
                  <TextBlock Classes="caption" Text="Foto" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
              <TextBlock Classes="caption" Text="{Binding ResultPlaceholderLabel}"
                         TextWrapping="Wrap" TextAlignment="Center"
                         MaxWidth="360" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- State 2 — Processing (§9.9: indeterminate) -->
            <StackPanel IsVisible="{Binding IsResultProcessing}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="{StaticResource App.Space.M}">
              <ProgressBar Classes="busy" HorizontalAlignment="Center" />
              <TextBlock Text="Memverifikasi..." FontWeight="SemiBold"
                         FontSize="{StaticResource App.Type.BodyLarge}"
                         Foreground="{DynamicResource App.Text.Primary.Brush}"
                         HorizontalAlignment="Center" />
              <TextBlock Classes="caption" Text="{Binding ScanStatus}"
                         TextWrapping="Wrap" TextAlignment="Center"
                         IsVisible="{Binding IsFingerprintMode}" />
              <TextBlock Classes="caption" Text="{Binding FaceStatus}"
                         TextWrapping="Wrap" TextAlignment="Center"
                         IsVisible="{Binding IsWajahMode}" />
            </StackPanel>

            <!-- State 3 — Success: banner + foto hasil + field identitas -->
            <StackPanel IsVisible="{Binding IsResultSuccess}" VerticalAlignment="Top"
                        Spacing="{StaticResource App.Space.M}">
              <Border Classes="banner success" IsVisible="{Binding HasStatus}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                  <TextBlock Classes="glyph" Text="&#xE73E;" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>

              <Border Classes="photo-slot" HorizontalAlignment="Center"
                      IsVisible="{Binding HasResultImage}">
                <Panel>
                  <Image Source="{Binding FingerImage, Converter={StaticResource Base64Image}}"
                         Stretch="Uniform" IsVisible="{Binding IsFingerprintMode}" />
                  <Image Source="{Binding CapturedPhoto}"
                         Stretch="Uniform" IsVisible="{Binding IsWajahMode}" />
                </Panel>
              </Border>

              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Nama" Margin="0,0,0,12" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding ResultNama}"
                           FontSize="{StaticResource App.Type.BodyLarge}" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="No. Kartu" Margin="0,0,0,12" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding ResultNoKartu}"
                           TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="Usia" Margin="0,0,0,12" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding ResultUsia}" Margin="0,0,0,12" />
                <TextBlock Grid.Row="3" Grid.Column="0" Classes="field-label" Text="Keterangan" />
                <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding ResultKeterangan}" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>

            <!-- State 4 — Failure: banner Danger + saran aksi -->
            <Border Classes="banner danger" IsVisible="{Binding IsResultFailure}" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                <TextBlock Classes="glyph" Text="&#xE783;" VerticalAlignment="Center" />
                <StackPanel Spacing="{StaticResource App.Space.XS}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="Periksa perangkat dan koneksi, lalu coba lagi."
                             TextWrapping="Wrap" FontSize="{StaticResource App.Type.Small}" Opacity="0.9" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- State 5 — NoData (§14 A8): Warning, dibedakan dari Failure -->
            <Border Classes="banner warning" IsVisible="{Binding IsResultNoData}" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                <TextBlock Classes="glyph" Text="&#xE783;" VerticalAlignment="Center" />
                <StackPanel Spacing="{StaticResource App.Space.XS}" VerticalAlignment="Center">
                  <TextBlock Text="Data tidak ditemukan untuk NIK/kode tersebut."
                             TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                             FontSize="{StaticResource App.Type.Small}" Opacity="0.9" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== Overlay "Login Required" (§8.5, §10.3) ===== -->
    <Border IsVisible="{Binding !IsLoggedIn}"
            Background="{DynamicResource App.Background.Overlay.Brush}">
      <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource App.Surface.Card.Brush}"
              BorderBrush="{DynamicResource App.Border.Default.Brush}" BorderThickness="1"
              CornerRadius="{StaticResource App.Radius.XL}"
              BoxShadow="{StaticResource App.Shadow.Popup}"
              Padding="20">
        <StackPanel Spacing="{StaticResource App.Space.M}" HorizontalAlignment="Center">
          <TextBlock Classes="glyph" Text="&#xE72E;" FontSize="32"
                     Foreground="{DynamicResource App.Text.Muted.Brush}"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="h1" Text="Login Required" HorizontalAlignment="Center" />
          <TextBlock Classes="caption" Text="Silakan login untuk mengaktifkan verifikasi."
                     TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
          <Button Classes="primary large" Content="Login Sekarang"
                  Command="{Binding RequestLoginNowCommand}"
                  HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
