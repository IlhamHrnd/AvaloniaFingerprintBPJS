<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaFingerprint.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
             x:Class="AvaloniaFingerprint.Views.VerifikasiView"
             x:DataType="vm:VerifikasiViewModel">

  <Grid ColumnDefinitions="360,*" Margin="16">

    <Border Grid.Column="0" Classes="card" VerticalAlignment="Top" Margin="0,0,16,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Verifikasi" />

        <StackPanel Spacing="4">
          <TextBlock Text="NIK / No. BPJS" FontWeight="SemiBold" FontSize="12" />
          <TextBox Text="{Binding IdentityNumber}"
                   MaxLength="16"
                   PlaceholderText="Masukkan NIK atau No. BPJS"
                   Height="36" FontSize="15" />
          <TextBlock Classes="caption" Text="NIK 16 digit / No. BPJS 13 digit" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Metode Verifikasi" FontWeight="SemiBold" FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton GroupName="metode" Content="Fingerprint" IsChecked="{Binding IsFingerprintMode}" />
            <RadioButton GroupName="metode" Content="Wajah" IsChecked="{Binding IsWajahMode}" />
          </StackPanel>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsFingerprintMode}" Spacing="14">

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Verifikasi" Command="{Binding VerifyCommand}"
                    Height="38" MinWidth="120" HorizontalContentAlignment="Center"
                    Background="{StaticResource AccentBrush}" Foreground="White" />
            <Button Content="Bersihkan" Command="{Binding ClearCommand}"
                    Height="38" MinWidth="100" HorizontalContentAlignment="Center" />
          </StackPanel>

          <StackPanel IsVisible="{Binding IsScanning}" Spacing="6">
            <TextBlock Text="{Binding ScanStatus}" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource AccentBrush}" />
            <ProgressBar IsIndeterminate="True" Height="4" />
          </StackPanel>

          <Border IsVisible="{Binding !DeviceConnected}" CornerRadius="6" Padding="10" Background="#FEF3C7">
            <TextBlock Text="Perangkat fingerprint tidak terhubung. Verifikasi dinonaktifkan."
                       TextWrapping="Wrap" FontSize="12" Foreground="#92400E" />
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsWajahMode}" Spacing="10">
          <Border CornerRadius="6" Height="240"
                  Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1"
                  HorizontalAlignment="Stretch">
            <Panel>
              <Image Source="{Binding PreviewImage}"
                     Stretch="Uniform"
                     IsVisible="{Binding IsPreviewVisible}" />

              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                          IsVisible="{Binding !IsPreviewVisible}">
                <TextBlock Text="📷" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CameraTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CameraStatus}" Classes="caption" HorizontalAlignment="Center" />
              </StackPanel>
            </Panel>
          </Border>

          <Button Content="Hubungkan Kamera" Command="{Binding ConnectCameraCommand}"
                  Height="38" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  IsEnabled="{Binding !IsConnecting}"
                  Background="{StaticResource AccentBrush}" Foreground="White" />

          <Button Content="Upload Foto" Command="{Binding UploadPhotoCommand}"
                  Height="38" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="{StaticResource AccentBrush}" Foreground="White" />

          <Button Content="{Binding PhotoSourceActionLabel}" Command="{Binding TogglePhotoSourceCommand}"
                  IsVisible="{Binding HasUploadedPhoto}"
                  Height="38" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />

          <Button Content="Verifikasi Wajah" Command="{Binding VerifyFaceCommand}"
                  Height="38" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="{StaticResource AccentBrush}" Foreground="White" />

          <Border IsVisible="{Binding HasCameraDeviceList}" CornerRadius="6" Padding="10" Background="#F9FAFB"
                  BorderBrush="#E5E7EB" BorderThickness="1">
            <TextBlock Text="{Binding CameraDeviceList}" TextWrapping="Wrap" FontSize="12"
                       Foreground="#374151" />
          </Border>
        </StackPanel>

        <Border IsVisible="{Binding HasStatus}" CornerRadius="6" Padding="10" Background="#F3F4F6">
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{Binding !StatusIsError, Converter={StaticResource StatusBrush}}" />
        </Border>

        <Button Content="Hapus Foto" Command="{Binding ClearPhotoCommand}"
                IsVisible="{Binding HasAnyPhoto}"
                HorizontalAlignment="Stretch" Height="34"
                HorizontalContentAlignment="Center" />
      </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
      <StackPanel Spacing="14">
        <TextBlock Classes="h2" Text="Hasil Verifikasi" />

        <Grid ColumnDefinitions="Auto,*">

          <Border Grid.Column="0" Width="140" Height="180" CornerRadius="6" Margin="0,0,20,0"
                  Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1"
                  VerticalAlignment="Top">
            <Panel>
              <TextBlock Text="{Binding ResultPlaceholderLabel}" Classes="caption"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding !HasResultImage}" />

              <Image Source="{Binding FingerImage, Converter={StaticResource Base64Image}}"
                     Stretch="Uniform" Margin="6"
                     IsVisible="{Binding IsFingerprintMode}" />

              <Image Source="{Binding CapturedPhoto}"
                     Stretch="Uniform" Margin="6"
                     IsVisible="{Binding IsWajahMode}" />
            </Panel>
          </Border>

          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="130,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama" Classes="caption" Margin="0,0,0,12" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ResultNama}"
                       FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="No. Kartu" Classes="caption" Margin="0,0,0,12" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResultNoKartu}"
                       FontSize="15" Margin="0,0,0,12" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Usia" Classes="caption" Margin="0,0,0,12" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ResultUsia}"
                       FontSize="15" Margin="0,0,0,12" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Keterangan" Classes="caption" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ResultKeterangan}"
                       TextWrapping="Wrap" FontSize="12" />
          </Grid>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
