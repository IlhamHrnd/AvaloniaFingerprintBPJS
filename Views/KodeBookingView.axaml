<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaFingerprint.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
             x:Class="AvaloniaFingerprint.Views.KodeBookingView"
             x:DataType="vm:KodeBookingViewModel">

  <Panel>

    <!-- ===== Kartu tengah responsif (§8.6) =====
         Kartu mengikuti lebar parent (Stretch) dan dibatasi MaxWidth, bukan lebar tetap,
         agar tidak ada kontrol yang melewati border card pada window kecil.
         Konten dibungkus ScrollViewer (pola sama dengan VerifikasiView) supaya tinggi
         konten yang melebihi area tidak terpotong; scroll horizontal dimatikan. -->
    <Grid Margin="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Classes="card" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                MaxWidth="640">
          <StackPanel Spacing="{StaticResource App.Space.M}">

            <TextBlock Classes="h2" Text="Kode Booking" />

            <StackPanel Spacing="{StaticResource App.Space.XS}">
              <TextBlock Classes="field-label" Text="Kode Booking" />
              <TextBox Text="{Binding KodeBooking}" Height="36" MaxLength="16"
                       PlaceholderText="Masukkan kode booking"
                       IsEnabled="{Binding !IsBusy}" />
              <TextBlock Classes="caption" Text="Contoh: APT/260101-0011 → 0011" />
            </StackPanel>

            <!-- ===== Numpad sentuh (input angka tanpa keyboard fisik) =====
                 Hanya sufix angka yang diketik; awalan "APT/tanggal-" dibentuk aplikasi
                 di KodeBookingViewModel. Tombol menulis ke KodeBooking ( dua arah ),
                 tombol Reset tetap memakai ResetCommand yang sudah ada. -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="{StaticResource App.Space.S}"
                  RowSpacing="{StaticResource App.Space.S}"
                  IsEnabled="{Binding !IsBusy}">
              <Button Grid.Row="0" Grid.Column="0" Classes="numpad" Content="1"
                      Command="{Binding AppendDigitCommand}" CommandParameter="1"
                      AutomationProperties.Name="Angka 1" />
              <Button Grid.Row="0" Grid.Column="1" Classes="numpad" Content="2"
                      Command="{Binding AppendDigitCommand}" CommandParameter="2"
                      AutomationProperties.Name="Angka 2" />
              <Button Grid.Row="0" Grid.Column="2" Classes="numpad" Content="3"
                      Command="{Binding AppendDigitCommand}" CommandParameter="3"
                      AutomationProperties.Name="Angka 3" />

              <Button Grid.Row="1" Grid.Column="0" Classes="numpad" Content="4"
                      Command="{Binding AppendDigitCommand}" CommandParameter="4"
                      AutomationProperties.Name="Angka 4" />
              <Button Grid.Row="1" Grid.Column="1" Classes="numpad" Content="5"
                      Command="{Binding AppendDigitCommand}" CommandParameter="5"
                      AutomationProperties.Name="Angka 5" />
              <Button Grid.Row="1" Grid.Column="2" Classes="numpad" Content="6"
                      Command="{Binding AppendDigitCommand}" CommandParameter="6"
                      AutomationProperties.Name="Angka 6" />

              <Button Grid.Row="2" Grid.Column="0" Classes="numpad" Content="7"
                      Command="{Binding AppendDigitCommand}" CommandParameter="7"
                      AutomationProperties.Name="Angka 7" />
              <Button Grid.Row="2" Grid.Column="1" Classes="numpad" Content="8"
                      Command="{Binding AppendDigitCommand}" CommandParameter="8"
                      AutomationProperties.Name="Angka 8" />
              <Button Grid.Row="2" Grid.Column="2" Classes="numpad" Content="9"
                      Command="{Binding AppendDigitCommand}" CommandParameter="9"
                      AutomationProperties.Name="Angka 9" />

              <Button Grid.Row="3" Grid.Column="0" Classes="numpad" Content="0"
                      Command="{Binding AppendDigitCommand}" CommandParameter="0"
                      AutomationProperties.Name="Angka 0" />
              <Button Grid.Row="3" Grid.Column="1" Classes="numpad action"
                      Command="{Binding BackspaceCommand}"
                      AutomationProperties.Name="Hapus satu karakter">
                <TextBlock Classes="glyph" Text="&#xE750;"
                           Foreground="{DynamicResource App.Text.Secondary.Brush}" />
              </Button>
              <Button Grid.Row="3" Grid.Column="2" Classes="numpad action"
                      Command="{Binding ResetCommand}"
                      AutomationProperties.Name="Kosongkan input">
                <TextBlock Classes="glyph" Text="&#xE74D;"
                           Foreground="{DynamicResource App.Text.Secondary.Brush}" />
              </Button>
            </Grid>

            <!-- Tombol aksi: Grid 3 kolom berbobot sama (§9.1) supaya tombol ikut lebar card
                 dan tidak pernah memaksa keluar dari border. Perilaku command/busy tidak berubah. -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource App.Space.S}">
              <Button Grid.Column="0" Classes="primary" HorizontalAlignment="Stretch"
                      Command="{Binding SubmitCommand}"
                      IsEnabled="{Binding !IsBusy}"
                      AutomationProperties.Name="Verifikasi kode booking">
                <Panel>
                  <TextBlock Text="Verifikasi" HorizontalAlignment="Center" IsVisible="{Binding !IsBusy}" />
                  <ProgressBar Classes="busy" IsVisible="{Binding IsBusy}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.Text.OnAccent.Brush}"
                               Background="Transparent" />
                </Panel>
              </Button>
              <Button Grid.Column="1" Classes="secondary" Content="Cetak Ulang Barcode"
                      HorizontalAlignment="Stretch"
                      Command="{Binding CetakUlangBarcodeCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Grid.Column="2" Classes="secondary" Content="Reset"
                      HorizontalAlignment="Stretch"
                      Command="{Binding ResetCommand}"
                      IsEnabled="{Binding !IsBusy}" />
            </Grid>

            <!-- Busy (§9.1): teks primary + progress indeterminate 4px -->
            <StackPanel IsVisible="{Binding IsBusy}" Spacing="{StaticResource App.Space.XS}">
              <TextBlock Text="Memproses kode booking..." FontWeight="SemiBold"
                         FontSize="{StaticResource App.Type.Body}"
                         Foreground="{DynamicResource App.Primary.Default.Brush}" />
              <ProgressBar IsIndeterminate="True" Height="4" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- Banner status (§9.5): Success / Danger -->
            <StackPanel IsVisible="{Binding HasStatus}" Spacing="{StaticResource App.Space.S}">
              <Border Classes="banner success" IsVisible="{Binding !StatusIsError}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                  <TextBlock Classes="glyph" Text="&#xE73E;" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Classes="banner danger" IsVisible="{Binding StatusIsError}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                  <TextBlock Classes="glyph" Text="&#xE783;" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>
            </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>

    <!-- ===== Overlay "Login Required" (§8.5, §10.3) ===== -->
    <Border IsVisible="{Binding !IsLoggedIn}"
            Background="{DynamicResource App.Background.Overlay.Brush}">
      <Border MaxWidth="420" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource App.Surface.Card.Brush}"
              BorderBrush="{DynamicResource App.Border.Default.Brush}" BorderThickness="1"
              CornerRadius="{StaticResource App.Radius.XL}"
              BoxShadow="{StaticResource App.Shadow.Popup}"
              Padding="20">
        <StackPanel Spacing="{StaticResource App.Space.M}" HorizontalAlignment="Center">
          <TextBlock Classes="glyph" Text="&#xE72E;" FontSize="32"
                     Foreground="{DynamicResource App.Text.Muted.Brush}"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="h1" Text="Login Required" HorizontalAlignment="Center" />
          <TextBlock Classes="caption" Text="Silakan login untuk mengaktifkan proses kode booking."
                     TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
          <Button Classes="primary large" Content="Login Sekarang"
                  Command="{Binding RequestLoginNowCommand}"
                  HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
