<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaFingerprint.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="680"
             x:Class="AvaloniaFingerprint.Views.RujukanBaruView"
             x:DataType="vm:RujukanBaruViewModel">

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Background="{DynamicResource App.Surface.Sidebar.Brush}"
            Padding="24,14,24,12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource App.Space.M}">
        <Border Width="40" Height="40" VerticalAlignment="Center"
                Background="{DynamicResource App.Primary.Default.Brush}"
                CornerRadius="{StaticResource App.Radius.L}">
          <TextBlock Classes="glyph" Text="&#xE8A5;" FontSize="20"
                     Foreground="{DynamicResource App.Text.OnAccent.Brush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="Rujukan Baru"
                     Foreground="{DynamicResource App.Text.OnSidebar.Brush}" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="Registrasi pasien rujukan dan cetak label registrasi."
                     Foreground="{DynamicResource App.Text.OnSidebarMuted.Brush}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Konten form ===== -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16" Spacing="{StaticResource App.Space.L}">

        <Border Classes="card" VerticalAlignment="Top" HorizontalAlignment="Stretch">
          <StackPanel Spacing="{StaticResource App.Space.L}">

            <TextBlock Classes="h2" Text="Data Registrasi" Margin="0" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="{StaticResource App.Space.L}"
                  RowSpacing="0">
              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="2">
                <TextBlock Classes="field-label" Text="No. Rekam Medis"
                           MinHeight="{StaticResource App.Field.LabelRowHeight}" />
                <TextBlock Text="*" FontSize="{StaticResource App.Type.Caption}"
                           FontWeight="SemiBold" VerticalAlignment="Top"
                           Foreground="{DynamicResource App.Danger.Default.Brush}" />
              </StackPanel>

              <TextBlock Grid.Row="0" Grid.Column="1" Classes="field-label" Text="Nama Pasien"
                         MinHeight="{StaticResource App.Field.LabelRowHeight}" />
              <Grid Grid.Row="1" Grid.Column="0">
                <TextBox Text="{Binding NomorRekamMedis, Mode=TwoWay}"
                         Height="{StaticResource App.Field.Height}"
                         Padding="10,0,44,0" VerticalContentAlignment="Center"
                         IsEnabled="{Binding IsInputEnabled}"
                         PlaceholderText="Masukkan nomor rekam medis"
                         AutomationProperties.Name="No. Rekam Medis">
                  <!-- Enter = tombol cari (mempercepat alur pindai/keyboard). -->
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding CariPasienCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Classes="icon" Width="28" Height="28" Margin="0,0,4,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding CariPasienCommand}"
                        IsEnabled="{Binding IsInputEnabled}"
                        ToolTip.Tip="Cari pasien" AutomationProperties.Name="Cari pasien">
                  <TextBlock Classes="glyph" Text="&#xE721;" FontSize="14"
                             Foreground="{DynamicResource App.Primary.Default.Brush}" />
                </Button>
              </Grid>

              <Border Grid.Row="1" Grid.Column="1"
                      Height="{StaticResource App.Field.Height}" Padding="10,0"
                      Background="{DynamicResource App.Surface.Header.Brush}"
                      BorderBrush="{DynamicResource App.Border.Control.Brush}"
                      BorderThickness="1" CornerRadius="{StaticResource App.Radius.S}"
                      ToolTip.Tip="{Binding NamaPasien}"
                      AutomationProperties.Name="Nama Pasien">
                <TextBlock Text="{Binding NamaPasien}" VerticalAlignment="Center"
                           FontSize="{StaticResource App.Type.Body}"
                           Foreground="{DynamicResource App.Text.Secondary.Brush}"
                           TextTrimming="CharacterEllipsis" />
              </Border>
            </Grid>

            <!-- ===== Numpad sentuh No. Rekam Medis (§9.1 varian input sentuh) =====
                 Sama dengan numpad Verifikasi Sidik Jari: angka menulis ke NomorRekamMedis
                 lewat AppendDigitCommand, Backspace menghapus satu digit, dan Clear memakai
                 BersihkanCommand (reset halaman) seperti ClearCommand di Verifikasi. Nilai
                 tetap string sehingga nol di depan tidak hilang, dan pencarian pasien tetap
                 lewat tombol cari / Enter (tidak ada pencarian otomatis per digit). -->
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  MaxWidth="328" Margin="0,12,0,0"
                  ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="{StaticResource App.Space.S}"
                  RowSpacing="{StaticResource App.Space.S}"
                  IsEnabled="{Binding IsInputEnabled}">
              <Button Grid.Row="0" Grid.Column="0" Classes="numpad" Content="1"
                      Command="{Binding AppendDigitCommand}" CommandParameter="1"
                      AutomationProperties.Name="Angka 1" />
              <Button Grid.Row="0" Grid.Column="1" Classes="numpad" Content="2"
                      Command="{Binding AppendDigitCommand}" CommandParameter="2"
                      AutomationProperties.Name="Angka 2" />
              <Button Grid.Row="0" Grid.Column="2" Classes="numpad" Content="3"
                      Command="{Binding AppendDigitCommand}" CommandParameter="3"
                      AutomationProperties.Name="Angka 3" />

              <Button Grid.Row="1" Grid.Column="0" Classes="numpad" Content="4"
                      Command="{Binding AppendDigitCommand}" CommandParameter="4"
                      AutomationProperties.Name="Angka 4" />
              <Button Grid.Row="1" Grid.Column="1" Classes="numpad" Content="5"
                      Command="{Binding AppendDigitCommand}" CommandParameter="5"
                      AutomationProperties.Name="Angka 5" />
              <Button Grid.Row="1" Grid.Column="2" Classes="numpad" Content="6"
                      Command="{Binding AppendDigitCommand}" CommandParameter="6"
                      AutomationProperties.Name="Angka 6" />

              <Button Grid.Row="2" Grid.Column="0" Classes="numpad" Content="7"
                      Command="{Binding AppendDigitCommand}" CommandParameter="7"
                      AutomationProperties.Name="Angka 7" />
              <Button Grid.Row="2" Grid.Column="1" Classes="numpad" Content="8"
                      Command="{Binding AppendDigitCommand}" CommandParameter="8"
                      AutomationProperties.Name="Angka 8" />
              <Button Grid.Row="2" Grid.Column="2" Classes="numpad" Content="9"
                      Command="{Binding AppendDigitCommand}" CommandParameter="9"
                      AutomationProperties.Name="Angka 9" />

              <Button Grid.Row="3" Grid.Column="0" Classes="numpad" Content="0"
                      Command="{Binding AppendDigitCommand}" CommandParameter="0"
                      AutomationProperties.Name="Angka 0" />
              <Button Grid.Row="3" Grid.Column="1" Classes="numpad action"
                      Command="{Binding BackspaceCommand}"
                      AutomationProperties.Name="Hapus satu karakter">
                <TextBlock Classes="glyph" Text="&#xE750;"
                           Foreground="{DynamicResource App.Text.Secondary.Brush}" />
              </Button>
              <Button Grid.Row="3" Grid.Column="2" Classes="numpad action"
                      Command="{Binding BersihkanCommand}"
                      AutomationProperties.Name="Kosongkan input">
                <TextBlock Classes="glyph" Text="&#xE74D;"
                           Foreground="{DynamicResource App.Text.Secondary.Brush}" />
              </Button>
            </Grid>

            <!-- Busy (§9.1): teks primary + progress indeterminate 4px; teks mengikuti tahap proses -->
            <StackPanel IsVisible="{Binding IsBusy}" Spacing="{StaticResource App.Space.XS}">
              <TextBlock Text="{Binding BusyMessage}" FontWeight="SemiBold"
                         FontSize="{StaticResource App.Type.Body}"
                         Foreground="{DynamicResource App.Primary.Default.Brush}" />
              <ProgressBar IsIndeterminate="True" Height="4" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- Banner status (§9.5): Success / Danger -->
            <StackPanel IsVisible="{Binding HasStatus}" Spacing="{StaticResource App.Space.S}">
              <Border Classes="banner success" IsVisible="{Binding !StatusIsError}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                  <TextBlock Classes="glyph" Text="&#xE73E;" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Classes="banner danger" IsVisible="{Binding StatusIsError}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                  <TextBlock Classes="glyph" Text="&#xE783;" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>

            <Border Background="{DynamicResource App.Primary.Subtle.Brush}"
                    BorderBrush="{DynamicResource App.Border.Control.Brush}" BorderThickness="1"
                    CornerRadius="{StaticResource App.Radius.M}" Padding="16">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource App.Space.L}">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource App.Space.M}"
                      VerticalAlignment="Center">
                  <Border Width="36" Height="36" VerticalAlignment="Center" CornerRadius="18"
                          Background="{DynamicResource App.Surface.Card.Brush}"
                          BorderBrush="{DynamicResource App.Border.Default.Brush}" BorderThickness="1">
                    <TextBlock Classes="glyph" Text="&#xE928;" FontSize="18"
                               Foreground="{DynamicResource App.Primary.Default.Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Verifikasi Sidik Jari"
                               FontSize="{StaticResource App.Type.Body}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="Verifikasi Sidik Jari"
                               Foreground="{DynamicResource App.Text.Primary.Brush}" />
                    <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="560"
                               Text="Pastikan sidik jari peserta BPJS terverifikasi sebelum memilih rujukan." />
                  </StackPanel>
                </Grid>

                <Panel Grid.Column="1" VerticalAlignment="Center">
                  <Button Classes="primary large" MinWidth="160"
                          Command="{Binding VerifikasiFingerCommand}"
                          IsEnabled="{Binding IsInputEnabled}"
                          AutomationProperties.Name="Verifikasi Finger">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}"
                                HorizontalAlignment="Center">
                      <TextBlock Classes="glyph" Text="&#xE928;"
                                 Foreground="{DynamicResource App.Text.OnAccent.Brush}" />
                      <TextBlock Text="Verifikasi Finger" />
                    </StackPanel>
                  </Button>
                  <!-- Overlay busy (§9.1): tombol tetap di tempatnya, progress menutupi isinya
                       selama capture + verifikasi berjalan. Overlay menangkap klik supaya
                       pemindaian tidak bisa dipicu dua kali dari tombol yang sama. -->
                  <Border IsVisible="{Binding IsFingerprintBusy}" IsHitTestVisible="True"
                          Background="{DynamicResource App.Surface.Header.Brush}"
                          BorderBrush="{DynamicResource App.Border.Default.Brush}" BorderThickness="1"
                          CornerRadius="{StaticResource App.Radius.M}">
                    <ProgressBar Classes="busy" Width="96" VerticalAlignment="Center"
                                 HorizontalAlignment="Center" />
                  </Border>
                </Panel>
                <!-- Status verifikasi sidik jari (§11): 4 state — menunggu, memindai, gagal,
                     berhasil. Ukuran tetap supaya layout header tidak bergeser saat state
                     berubah. -->
                <Panel Grid.Column="2" Width="220"
                       Height="{StaticResource App.Control.Height.Large}"
                       VerticalAlignment="Center">
                  <Border Classes="banner" IsVisible="{Binding IsFingerprintPending}"
                          Padding="12,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource App.Space.S}">
                      <TextBlock Classes="glyph" Text="&#xE928;" VerticalAlignment="Center"
                                 Foreground="{DynamicResource App.Text.Secondary.Brush}" />
                      <TextBlock Grid.Column="1" Text="{Binding FingerprintStatusMessage}"
                                 VerticalAlignment="Center"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding FingerprintStatusMessage}"
                                 FontSize="{StaticResource App.Type.Body}"
                                 Foreground="{DynamicResource App.Text.Secondary.Brush}" />
                    </Grid>
                  </Border>
                  <Border Classes="banner info" IsVisible="{Binding IsFingerprintBusy}"
                          Padding="12,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource App.Space.S}">
                      <ProgressBar Classes="busy" Width="40" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding FingerprintStatusMessage}"
                                 VerticalAlignment="Center"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding FingerprintStatusMessage}"
                                 FontSize="{StaticResource App.Type.Body}"
                                 Foreground="{DynamicResource App.Info.Default.Brush}" />
                    </Grid>
                  </Border>
                  <Border Classes="banner danger" IsVisible="{Binding FingerprintStatusIsError}"
                          Padding="12,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource App.Space.S}">
                      <TextBlock Classes="glyph" Text="&#xE783;" VerticalAlignment="Center"
                                 Foreground="{DynamicResource App.Danger.Default.Brush}" />
                      <TextBlock Grid.Column="1" Text="{Binding FingerprintStatusMessage}"
                                 VerticalAlignment="Center"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding FingerprintStatusMessage}"
                                 FontSize="{StaticResource App.Type.Body}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource App.Danger.Default.Brush}" />
                    </Grid>
                  </Border>
                  <Border Classes="banner success" IsVisible="{Binding IsFingerprintVerified}"
                          Padding="12,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource App.Space.S}">
                      <TextBlock Classes="glyph" Text="&#xE73E;" VerticalAlignment="Center"
                                 Foreground="{DynamicResource App.Success.Default.Brush}" />
                      <TextBlock Grid.Column="1" Text="Berhasil Verifikasi" VerticalAlignment="Center"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="Berhasil Verifikasi"
                                 FontSize="{StaticResource App.Type.Body}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource App.Success.Default.Brush}" />
                    </Grid>
                  </Border>
                </Panel>
              </Grid>
            </Border>

            <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
              <TextBlock Grid.Row="0" Classes="field-label" Text="Rujukan Pasien"
                         MinHeight="{StaticResource App.Field.LabelRowHeight}" />
              <!-- Item = objek rujukan utuh (ViewModel.RujukanOption); teks tampilan dari Display.
                   Tidak ada auto-select: petugas memilih sendiri rujukan yang dipakai. -->
              <ComboBox Grid.Row="1" ItemsSource="{Binding RujukanOptions}"
                        SelectedItem="{Binding SelectedRujukan, Mode=TwoWay}"
                        IsEnabled="{Binding IsRujukanEnabled}"
                        PlaceholderText="Pilih rujukan pasien"
                        Height="{StaticResource App.Field.Height}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="{Binding RujukanDisplay}"
                        AutomationProperties.Name="Rujukan Pasien" />
            </Grid>

            <!-- Busy rujukan: pasien sudah ditemukan, daftar rujukan sedang diambil (§6). -->
            <StackPanel IsVisible="{Binding IsRujukanBusy}"
                        Spacing="{StaticResource App.Space.XS}">
              <TextBlock Text="Memuat rujukan pasien..." FontWeight="SemiBold"
                         FontSize="{StaticResource App.Type.Body}"
                         Foreground="{DynamicResource App.Primary.Default.Brush}" />
              <ProgressBar IsIndeterminate="True" Height="4" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- Status rujukan (§9.5): warning = tidak ada rujukan, danger = API/metadata gagal.
                 Banner pencarian pasien di atas tetap menampilkan identitas pasien. -->
            <Border Classes="banner warning" IsVisible="{Binding RujukanStatusIsEmpty}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                <TextBlock Classes="glyph" Text="&#xE783;" VerticalAlignment="Center" />
                <StackPanel Spacing="{StaticResource App.Space.XS}" VerticalAlignment="Center">
                  <TextBlock Text="Rujukan tidak ditemukan"
                             TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding RujukanStatusMessage}" TextWrapping="Wrap"
                             FontSize="{StaticResource App.Type.Small}" Opacity="0.9" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="banner danger" IsVisible="{Binding RujukanStatusIsError}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                <TextBlock Classes="glyph" Text="&#xE783;" VerticalAlignment="Center" />
                <TextBlock Text="{Binding RujukanStatusMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="{StaticResource App.Space.L}"
                  RowSpacing="0">

              <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Poli"
                         MinHeight="{StaticResource App.Field.LabelRowHeight}" />

              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                          Spacing="{StaticResource App.Space.XS}">
                <TextBlock Classes="field-label" Text="Dokter"
                           MinHeight="{StaticResource App.Field.LabelRowHeight}" />
                <!-- Info kuota: tooltip kaya konten, memakai style ToolTip global (§9.8) -->
                <Button Classes="icon" Width="20" Height="20" VerticalAlignment="Center"
                        ToolTip.ShowDelay="200" ToolTip.Placement="Bottom"
                        AutomationProperties.Name="Informasi Kuota Layanan">
                  <ToolTip.Tip>
                    <StackPanel Width="200" Spacing="{StaticResource App.Space.S}">
                      <TextBlock Text="Informasi Kuota Layanan" FontWeight="SemiBold"
                                 FontSize="{StaticResource App.Type.Body}"
                                 Foreground="{DynamicResource App.Text.Primary.Brush}" />
                      <Border Height="1" Background="{DynamicResource App.Border.Default.Brush}" />
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="{StaticResource App.Space.XS}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="Total Kuota" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding KuotaTotalText}" FontWeight="SemiBold"
                                   FontSize="{StaticResource App.Type.Body}"
                                   Foreground="{DynamicResource App.Info.Default.Brush}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="Kuota Terpakai" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding KuotaTerpakaiText}" FontWeight="SemiBold"
                                   FontSize="{StaticResource App.Type.Body}"
                                   Foreground="{DynamicResource App.Warning.Default.Brush}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="caption" Text="Kuota Sisa" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding KuotaSisaText}" FontWeight="SemiBold"
                                   FontSize="{StaticResource App.Type.Body}"
                                   Foreground="{DynamicResource App.Success.Default.Brush}" />
                      </Grid>
                    </StackPanel>
                  </ToolTip.Tip>
                  <Button.Content>
                    <TextBlock Classes="glyph" Text="&#xE946;" FontSize="14"
                               Foreground="{DynamicResource App.Info.Default.Brush}" />
                  </Button.Content>
                </Button>
              </StackPanel>

              <!-- Item = objek poli utuh (ViewModel.PoliOption); teks tampilan dari Display.
                   Tidak ada auto-select dan daftar baru dimuat setelah rujukan dipilih. -->
              <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding PoliOptions}"
                        SelectedItem="{Binding SelectedPoli, Mode=TwoWay}"
                        Height="{StaticResource App.Field.Height}"
                        IsEnabled="{Binding IsPoliEnabled}"
                        PlaceholderText="Pilih poli"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="{Binding PoliDisplay}"
                        AutomationProperties.Name="Poli" />
              <!-- Item = jadwal dokter utuh (ViewModel.DokterOption); teks dari paramedicname. -->
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DokterOptions}"
                        SelectedItem="{Binding SelectedDokter, Mode=TwoWay}"
                        Height="{StaticResource App.Field.Height}"
                        IsEnabled="{Binding IsDokterEnabled}"
                        PlaceholderText="Pilih dokter"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="{Binding DokterDisplay}"
                        AutomationProperties.Name="Dokter" />
            </Grid>

            <!-- Busy poli: rujukan sudah dipilih, unit layanan sedang diambil (§6). -->
            <StackPanel IsVisible="{Binding IsPoliBusy}"
                        Spacing="{StaticResource App.Space.XS}">
              <TextBlock Text="Memuat daftar poli..." FontWeight="SemiBold"
                         FontSize="{StaticResource App.Type.Body}"
                         Foreground="{DynamicResource App.Primary.Default.Brush}" />
              <ProgressBar IsIndeterminate="True" Height="4" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- Status poli (§9.5): warning = tidak ada unit layanan, danger = API gagal. -->
            <Border Classes="banner warning" IsVisible="{Binding PoliStatusIsEmpty}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                <TextBlock Classes="glyph" Text="&#xE783;" VerticalAlignment="Center" />
                <StackPanel Spacing="{StaticResource App.Space.XS}" VerticalAlignment="Center">
                  <TextBlock Text="Poli tidak ditemukan"
                             TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding PoliStatusMessage}" TextWrapping="Wrap"
                             FontSize="{StaticResource App.Type.Small}" Opacity="0.9" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="banner danger" IsVisible="{Binding PoliStatusIsError}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                <TextBlock Classes="glyph" Text="&#xE783;" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PoliStatusMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- Busy dokter: poli sudah dipilih, jadwal hari ini sedang diambil (§6). -->
            <StackPanel IsVisible="{Binding IsDokterBusy}"
                        Spacing="{StaticResource App.Space.XS}">
              <TextBlock Text="Memuat jadwal dokter..." FontWeight="SemiBold"
                         FontSize="{StaticResource App.Type.Body}"
                         Foreground="{DynamicResource App.Primary.Default.Brush}" />
              <ProgressBar IsIndeterminate="True" Height="4" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- Status dokter (§9.5): warning = tidak ada jadwal, danger = API gagal. -->
            <Border Classes="banner warning" IsVisible="{Binding DokterStatusIsEmpty}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                <TextBlock Classes="glyph" Text="&#xE783;" VerticalAlignment="Center" />
                <StackPanel Spacing="{StaticResource App.Space.XS}" VerticalAlignment="Center">
                  <TextBlock Text="Jadwal dokter tidak ditemukan"
                             TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding DokterStatusMessage}" TextWrapping="Wrap"
                             FontSize="{StaticResource App.Type.Small}" Opacity="0.9" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="banner danger" IsVisible="{Binding DokterStatusIsError}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
                <TextBlock Classes="glyph" Text="&#xE783;" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DokterStatusMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>


            
            <Border Height="1" Background="{DynamicResource App.Border.Default.Brush}" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}"
                        HorizontalAlignment="Right">
              <Button Classes="secondary large" VerticalAlignment="Center"
                      Command="{Binding BersihkanCommand}"
                      IsEnabled="{Binding IsInputEnabled}"
                      AutomationProperties.Name="Bersihkan">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}"
                            HorizontalAlignment="Center">
                  <TextBlock Classes="glyph" Text="&#xE72C;"
                             Foreground="{DynamicResource App.Text.Secondary.Brush}" />
                  <TextBlock Text="Bersihkan" />
                </StackPanel>
              </Button>
              <Button Classes="primary large" VerticalAlignment="Center"
                      Command="{Binding CetakLabelCommand}"
                      IsEnabled="{Binding IsInputEnabled}"
                      AutomationProperties.Name="Cetak Label">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}"
                            HorizontalAlignment="Center">
                  <TextBlock Classes="glyph" Text="&#xE749;"
                             Foreground="{DynamicResource App.Text.OnAccent.Brush}" />
                  <TextBlock Text="Cetak Label" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Overlay "Login Required" (§8.5, §10.3) =====
         Sama persis dengan overlay di VerifikasiView/KodeBookingView; hanya teks caption
         yang berbeda. Scrim menutup header + form (RowSpan 2) sehingga tidak ada kontrol
         yang bisa diklik selama sesi belum login. -->
    <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding !IsLoggedIn}"
            Background="{DynamicResource App.Background.Overlay.Brush}">
      <Border MaxWidth="420" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource App.Surface.Card.Brush}"
              BorderBrush="{DynamicResource App.Border.Default.Brush}" BorderThickness="1"
              CornerRadius="{StaticResource App.Radius.XL}"
              BoxShadow="{StaticResource App.Shadow.Popup}"
              Padding="20">
        <StackPanel Spacing="{StaticResource App.Space.M}" HorizontalAlignment="Center">
          <TextBlock Classes="glyph" Text="&#xE72E;" FontSize="32"
                     Foreground="{DynamicResource App.Text.Muted.Brush}"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="h1" Text="Login Required" HorizontalAlignment="Center" />
          <TextBlock Classes="caption" Text="Silakan login untuk mengaktifkan proses registrasi rujukan."
                     TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
          <Button Classes="primary large" Content="Login Sekarang"
                  Command="{Binding RequestLoginNowCommand}"
                  HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
