<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AvaloniaFingerprint.ViewModels"
        xmlns:views="using:AvaloniaFingerprint.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="AvaloniaFingerprint.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1040" Height="720"
        MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB"
        Title="Avalonia Fingerprint">

  <DockPanel>

    <!-- ============ header: title, device status, login button (top right) ============ -->
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,8">
      <DockPanel LastChildFill="True">

        <!-- petugas + login/logout: di-dock lebih dulu supaya selalu mendapat lebar penuh
             dan tombol Logout tidak pernah terpotong saat window diperkecil -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10"
                    VerticalAlignment="Center">
          <StackPanel HorizontalAlignment="Right" MaxWidth="180"
                      ToolTip.Tip="{Binding PetugasName}">
            <TextBlock Text="{Binding PetugasName}" FontWeight="SemiBold"
                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding PetugasDetail}" Classes="caption"
                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Content="{Binding LoginButtonText}"
                  Command="{Binding ToggleLoginCommand}"
                  IsEnabled="{Binding !IsLoginBusy}"
                  MinWidth="96" Height="34"
                  HorizontalContentAlignment="Center"
                  Background="{StaticResource AccentBrush}" Foreground="White" />
        </StackPanel>

        <!-- device indicators: chip ringkas (icon warna + label), detail hanya di tooltip -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="0,0,16,0"
                    VerticalAlignment="Center">

          <!-- USB fingerprint indicator -->
          <Border Padding="10,5" CornerRadius="14" Background="{StaticResource HeaderBrush}"
                  ToolTip.Tip="{Binding DeviceTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding DeviceConnected, Converter={StaticResource StatusBrush}}" />
              <TextBlock Text="Fingerprint" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
          </Border>

          <!-- camera indicator (same styling as the fingerprint indicator) -->
          <Border Padding="10,5" CornerRadius="14" Background="{StaticResource HeaderBrush}"
                  ToolTip.Tip="{Binding CameraTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding CameraConnected, Converter={StaticResource StatusBrush}}" />
              <TextBlock Text="Kamera" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- title: mengisi sisa ruang, menyusut lebih dulu dan memakai ellipsis -->
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="Fingerprint BPJS" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="caption" Text="Verifikasi · Registrasi · Kode Booking · Verifikasi Wajah"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ status bar ============ -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="caption"
                   Text="{Binding DeviceDetail}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Classes="caption" Text="AvaloniaFingerprint" />
      </Grid>
    </Border>

    <!-- ============ tabs (disabled until login) ============ -->
    <Grid Margin="20">
      <TabControl>
        <TabItem Header="Verifikasi Fingerprint" IsEnabled="{Binding IsLoggedIn}">
          <views:VerifikasiFingerprintView DataContext="{Binding Verifikasi}" />
        </TabItem>
        <TabItem Header="Registrasi Fingerprint" IsEnabled="{Binding IsLoggedIn}">
          <views:RegistrasiFingerprintView DataContext="{Binding Registrasi}" />
        </TabItem>
        <TabItem Header="Kode Booking" IsEnabled="{Binding IsLoggedIn}">
          <views:KodeBookingView DataContext="{Binding KodeBooking}" />
        </TabItem>
        <TabItem Header="Verifikasi Wajah" IsEnabled="{Binding IsLoggedIn}">
          <views:VerifikasiWajahView DataContext="{Binding VerifikasiWajah}" />
        </TabItem>
      </TabControl>

      <!-- overlay shown while logged out -->
      <Border IsVisible="{Binding !IsLoggedIn}"
              Background="#F9FAFB" CornerRadius="8"
              Margin="0,44,0,0">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420">
          <TextBlock Text="🔒" FontSize="40" HorizontalAlignment="Center" />
          <TextBlock Classes="h2" HorizontalAlignment="Center" Text="Semua tab terkunci" />
          <TextBlock TextWrapping="Wrap" TextAlignment="Center" Classes="caption"
                     Text="Login petugas terlebih dahulu melalui tombol Login di kanan atas untuk mengaktifkan tab Verifikasi, Registrasi, Kode Booking, dan Verifikasi Wajah." />
          <Button Content="Login sekarang" Command="{Binding ToggleLoginCommand}"
                  HorizontalAlignment="Center" Margin="0,8,0,0" Height="36" MinWidth="140"
                  HorizontalContentAlignment="Center"
                  Background="{StaticResource AccentBrush}" Foreground="White" />
        </StackPanel>
      </Border>
    </Grid>

  </DockPanel>
</Window>
