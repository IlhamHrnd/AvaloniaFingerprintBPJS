<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AvaloniaFingerprint.ViewModels"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="420"
        x:Class="AvaloniaFingerprint.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Width="440" Height="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource App.Font.Default}"
        Background="{DynamicResource App.Background.Base.Brush}"
        Title="Login Petugas">

  <!-- Kartu login terpusat (§8.7); tanpa override style lokal -->
  <Grid Margin="16">
    <Border VerticalAlignment="Center"
            Background="{DynamicResource App.Surface.Card.Brush}"
            BorderBrush="{DynamicResource App.Border.Default.Brush}" BorderThickness="1"
            CornerRadius="{StaticResource App.Radius.L}"
            Padding="24">
      <StackPanel Spacing="{StaticResource App.Space.M}">

        <!-- Header kartu -->
        <StackPanel Spacing="{StaticResource App.Space.XS}" HorizontalAlignment="Center">
          <TextBlock Classes="glyph" Text="&#xE928;" FontSize="24"
                     Foreground="{DynamicResource App.Primary.Default.Brush}"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="h2" Text="Login Petugas" HorizontalAlignment="Center" />
          <TextBlock Classes="caption" Text="Masuk untuk mengaktifkan verifikasi"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Username (§9.2) -->
        <StackPanel Spacing="{StaticResource App.Space.XS}">
          <TextBlock Classes="field-label" Text="Username" />
          <TextBox x:Name="UsernameBox" Text="{Binding Username}" Height="36"
                   PlaceholderText="Username" />
        </StackPanel>

        <!-- Password + RevealPassword -->
        <StackPanel Spacing="{StaticResource App.Space.XS}">
          <TextBlock Classes="field-label" Text="Password" />
          <TextBox x:Name="PasswordBox" Text="{Binding Password}" Height="36"
                   PasswordChar="•" PlaceholderText="Password" />
          <CheckBox x:Name="RevealCheck" Content="Tampilkan password"
                    IsCheckedChanged="OnRevealPasswordChanged" />
        </StackPanel>

        <!-- Status: banner Danger (§9.5) -->
        <Border Classes="banner danger" IsVisible="{Binding HasMessage}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource App.Space.S}">
            <TextBlock Classes="glyph" Text="&#xE783;" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Login: Primary L full-width; busy → progress + disabled (§8.7.5) -->
        <Button Classes="primary large" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding LoginCommand}" IsDefault="True"
                AutomationProperties.Name="Login">
          <Panel>
            <TextBlock Text="Login" HorizontalAlignment="Center" IsVisible="{Binding !IsBusy}" />
            <ProgressBar Classes="busy" IsVisible="{Binding IsBusy}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource App.Text.OnAccent.Brush}"
                         Background="Transparent" />
          </Panel>
        </Button>

        <!-- Esc membatalkan (§8.7.7) -->
        <Button Classes="ghost" Content="Batal" Command="{Binding CancelCommand}"
                IsCancel="True" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
